# Copie para .env e preencha com valores reais — nunca commitar .env.
# Variáveis sem prefixo VITE_ são server-only (nunca chegam ao browser).

# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IA (Copilot) — provider configurável; Gemini é o único implementado hoje.
# Chave gratuita em https://aistudio.google.com/apikey — nunca chega ao browser.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opcional — timeout (ms) de qualquer chamada ao provider de IA. Default: 25000.
AI_TIMEOUT_MS=

# E-mail (integração real via Gmail OAuth) — provider configurável; Gmail é o
# único implementado hoje. Crie um OAuth Client ID em
# https://console.cloud.google.com/apis/credentials (tipo "Web application"),
# habilite a Gmail API, adicione GOOGLE_OAUTH_REDIRECT_URI como URI de redirect
# autorizado (ex.: http://localhost:8080/integracoes/email/callback em dev) e
# adicione a conta que for testar como "test user" na tela de consentimento.
EMAIL_PROVIDER=gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Chave simétrica de 32 bytes em base64 para criptografar os tokens OAuth
# armazenados (AES-256-GCM) e assinar o `state` do fluxo OAuth — gere com
# `openssl rand -base64 32`. Nunca chega ao browser; perder/trocar essa
# chave invalida qualquer conexão de e-mail já salva (é preciso reconectar).
EMAIL_TOKEN_ENCRYPTION_KEY=

# Fiscal (leitura de obrigações/apuração de um sistema de produção externo)
# — AINDA NÃO FUNCIONAL em nenhum dos dois providers: autenticação (onde
# confirmada), timeout e retry estão implementados (ver src/lib/fiscal/),
# mas o endpoint real de LEITURA de obrigações/apuração não está confirmado
# publicamente nem para Alterdata nem para Sittax; preencher estas
# variáveis não liga uma integração de verdade ainda, só permite testar a
# fábrica de provider e a primitiva HTTP (request()) contra um servidor de
# teste local. FISCAL_PROVIDER escolhe qual bloco abaixo vale.
FISCAL_PROVIDER=alterdata

# Alterdata (ePlugin) — autenticação (Bearer JWT) confirmada publicamente;
# endpoint de leitura, não. Token gerado em eContador → Configurações →
# ePlugin/Chave de Acesso (exige plano eContador Master).
ALTERDATA_API_TOKEN=
ALTERDATA_API_BASE_URL=

# Sittax — só a EXISTÊNCIA de uma "API de Integração" com chave de API é
# confirmada publicamente; a documentação encontrada cobre importação de
# NF-e (fluxo de entrada), não leitura de apuração (o que o ContaAI
# precisa). SITTAX_API_KEY_HEADER não tem valor-padrão de propósito — o
# nome do header não está confirmado, preencher só depois que o suporte da
# Sittax confirmar. Ver src/lib/fiscal/sittax-provider.server.ts.
SITTAX_API_KEY=
SITTAX_API_KEY_HEADER=
SITTAX_API_BASE_URL=

# Opcional — timeout (ms) de qualquer chamada HTTP a um provider fiscal. Default: 15000.
FISCAL_HTTP_TIMEOUT_MS=
