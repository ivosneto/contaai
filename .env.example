# Copie para .env e preencha com valores reais — nunca commitar .env.
# Variáveis sem prefixo VITE_ são server-only (nunca chegam ao browser).

# Supabase
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IA (Copilot) — provider configurável; Gemini é o único implementado hoje.
# Chave gratuita em https://aistudio.google.com/apikey — nunca chega ao browser.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# E-mail (integração real via Gmail OAuth) — provider configurável; Gmail é o
# único implementado hoje. Crie um OAuth Client ID em
# https://console.cloud.google.com/apis/credentials (tipo "Web application"),
# habilite a Gmail API, adicione GOOGLE_OAUTH_REDIRECT_URI como URI de redirect
# autorizado (ex.: http://localhost:8080/integracoes/email/callback em dev) e
# adicione a conta que for testar como "test user" na tela de consentimento.
EMAIL_PROVIDER=gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Chave simétrica de 32 bytes em base64 para criptografar os tokens OAuth
# armazenados (AES-256-GCM) e assinar o `state` do fluxo OAuth — gere com
# `openssl rand -base64 32`. Nunca chega ao browser; perder/trocar essa
# chave invalida qualquer conexão de e-mail já salva (é preciso reconectar).
EMAIL_TOKEN_ENCRYPTION_KEY=
